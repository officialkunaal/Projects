bool isMatch(char* s, char* p) {
    int m = 0;
    while (*(s + m) != '\0') {
        m++;
    }

    int n = 0;
    while (*(p + n) != '\0') {
        n++;
    }

    
    bool dp[21][21];
    for (int i = 0; i <= m; i++) {
        for (int j = 0; j <= n; j++) {
            *(*(dp + i) + j) = false;
        }
    }

    
    *(*(dp + 0) + 0) = true;

    
    for (int j = 2; j <= n; j++) {
        if (*(p + j - 1) == '*') {
            *(*(dp + 0) + j) = *(*(dp + 0) + j - 2);
        }
    }

    for (int i = 1; i <= m; i++) {
        for (int j = 1; j <= n; j++) {
            char sc = *(s + i - 1);
            char pc = *(p + j - 1);

            if (pc == '.' || pc == sc) {
                *(*(dp + i) + j) = *(*(dp + i - 1) + j - 1);
            } else if (pc == '*') {
                
                bool zero_occ = *(*(dp + i) + j - 2);

                
                char prev_p = *(p + j - 2);
                bool one_or_more = (prev_p == '.' || prev_p == sc) && *(*(dp + i - 1) + j);

                *(*(dp + i) + j) = zero_occ || one_or_more;
            }
        }
    }

    return *(*(dp + m) + n);
}
