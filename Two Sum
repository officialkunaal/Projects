#define TABLE_SIZE 20011

typedef struct {
    int key;
    int val;
    bool occupied;
} HashEntry;

int hash(int key) {
    unsigned int ukey = (unsigned int)key;
    return ukey % TABLE_SIZE;
}

void insert(HashEntry* table, int key, int val) {
    int idx = hash(key);
    while (table[idx].occupied) {
        if (table[idx].key == key) {
            table[idx].val = val;
            return;
        }
        idx = (idx + 1) % TABLE_SIZE;
    }
    table[idx].key = key;
    table[idx].val = val;
    table[idx].occupied = true;
}

int search(HashEntry* table, int key, bool* found) {
    int idx = hash(key);
    while (table[idx].occupied) {
        if (table[idx].key == key) {
            *found = true;
            return table[idx].val;
        }
        idx = (idx + 1) % TABLE_SIZE;
    }
    *found = false;
    return -1;
}
int* twoSum(int* nums, int numsSize, int target, int* returnSize) {
    HashEntry* table = (HashEntry*)calloc(TABLE_SIZE, sizeof(HashEntry));
    int* result = (int*)malloc(2 * sizeof(int));
    *returnSize = 2;

    for (int i = 0; i < numsSize; i++) {
        long long complement = (long long)target - nums[i];

        if (complement >= -1000000000LL && complement <= 1000000000LL) {
            bool found = false;
            int prev_idx = search(table, (int)complement, &found);
            if (found) {
                *(result + 0) = prev_idx;
                *(result + 1) = i;
                free(table);
                return result;
            }
        }
        insert(table, nums[i], i);
    }

    free(table);
    *returnSize = 0;
    return NULL;
}
